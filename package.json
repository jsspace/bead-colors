    "./perler-103": { "types": "./palette.d.ts", "default": "./palettes/perler-103.js" },
    "./hama": { "types": "./palette.d.ts", "default": "./palettes/hama.js" },
    "./hama-solid": { "types": "./palette.d.ts", "default": "./palettes/hama-solid.js" },
    "./artkal-m": { "types": "./palette.d.ts", "default": "./palettes/artkal-m.js" },
    "./artkal-s": { "types": "./palette.d.ts", "default": "./palettes/artkal-s.js" },
    "./nabbi": { "types": "./palette.d.ts", "default": "./palettes/nabbi.js" },
    "./mard": { "types": "./palette.d.ts", "default": "./palettes/mard.js" },
    "./mard-185": { "types": "./palette.d.ts", "default": "./palettes/mard-185.js" },
    "./mard-291": { "types": "./palette.d.ts", "default": "./palettes/mard-291.js" }

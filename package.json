  "files": ["index.js", "index.d.ts", "palette.d.ts", "palettes/", "README.md", "LICENSE", "LICENSES/", "THIRD_PARTY_NOTICES.md"],
  "keywords": ["perler", "perler beads", "fuse beads", "bead colors", "hama", "artkal", "mard", "nabbi", "pixel art"],
